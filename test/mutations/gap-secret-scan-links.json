{
  "tests": [
    "test/secret-scan-links.test.js"
  ],
  "expectBaselinePass": 9,
  "mutations": [
    {
      "name": "GPT-04: the boundary goes back to a lexical comparison, which a junction defeats",
      "file": "scripts/secret-scan.mjs",
      "anchor": "  const rel = relative(rootReal, real);",
      "replacement": "  const rel = relative(root, absPath);",
      "expectCaught": true
    },
    {
      "name": "GPT-04: the walk stops refusing a link that leaves the repository",
      "file": "scripts/secret-scan.mjs",
      "anchor": "        refuseOutside(toRepoPath(full), full);",
      "replacement": "        continue;",
      "expectCaught": true
    },
    {
      "name": "GPT-04: a named path skips the real-path check",
      "file": "scripts/secret-scan.mjs",
      "anchor": "  if (!resolveInsideRepo(abs)) refuseOutside(entry, abs);",
      "replacement": "  if (false) refuseOutside(entry, abs);",
      "expectCaught": true
    },
    {
      "name": "GPT-04: every scanned file skips the real-path check, so the git-listed default set can read outside",
      "file": "scripts/secret-scan.mjs",
      "anchor": "  if (!resolveInsideRepo(abs)) refuseOutside(file, abs);",
      "replacement": "  if (false) refuseOutside(file, abs);",
      "expectCaught": true
    }
  ]
}
