{
  "tests": [
    "test/secret-scan-untracked.test.js"
  ],
  "expectBaselinePass": 2,
  "mutations": [
    {
      "name": "G-3: an explicit directory argument is silently dropped again",
      "file": "scripts/secret-scan.mjs",
      "anchor": "  if (args.length) return args.flatMap(expandInput);",
      "replacement": "  if (args.length) return args;",
      "expectCaught": true
    },
    {
      "name": "G-3: the directory walk stops recursing into subdirectories",
      "file": "scripts/secret-scan.mjs",
      "anchor": "      if (isDir) { seen.add(real); walk(full); }",
      "replacement": "      if (false) { seen.add(real); walk(full); }",
      "expectCaught": true
    },
    {
      "name": "G-3: excluded binary/archive extensions are scanned anyway",
      "file": "scripts/secret-scan.mjs",
      "anchor": "  return [...IGNORED_EXTENSIONS].some(ext => lower.endsWith(ext) || lowerResolved.endsWith(ext));",
      "replacement": "  return false;",
      "expectCaught": true
    },
    {
      "name": "G-3: nonexistent named inputs are discarded before validation",
      "file": "scripts/secret-scan.mjs",
      "anchor": "  if (args.length) return args.flatMap(expandInput);",
      "replacement": "  if (args.length) return args.filter(entry => existsSync(resolve(root, entry))).flatMap(expandInput);",
      "expectCaught": true
    },
    {
      "name": "G-3: a named path outside the repository is silently dropped again",
      "file": "scripts/secret-scan.mjs",
      "anchor": "  if (!resolveInsideRepo(abs)) refuseOutside(entry, abs);",
      "replacement": "  if (false) refuseOutside(entry, abs);",
      "expectCaught": true
    }
  ]
}
